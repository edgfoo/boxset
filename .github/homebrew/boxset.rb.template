class Boxset < Formula
  desc "Prepare video for the web"
  homepage "https://github.com/edgfoo/boxset"
  license any_of: ["MIT", "Apache-2.0"]

  if Hardware::CPU.arm?
    url "https://github.com/edgfoo/boxset/releases/download/v__VERSION__/boxset-v__VERSION__-aarch64-apple-darwin.tar.gz"
    sha256 "__SHA256_ARM64__"
  else
    url "https://github.com/edgfoo/boxset/releases/download/v__VERSION__/boxset-v__VERSION__-x86_64-apple-darwin.tar.gz"
    sha256 "__SHA256_X86_64__"
  end

  # boxset needs ffmpeg >= 7.0, enforced at runtime against MIN_FFMPEG_VERSION
  # in src/command.rs. Homebrew has no minimum-version syntax.
  depends_on "ffmpeg"
  depends_on :macos

  def install
    bin.install "boxset"
  end

  test do
    assert_match "boxset #{version}", shell_output("#{bin}/boxset --version")
  end
end
