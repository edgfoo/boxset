{
  "$id": "https://github.com/edgfoo/boxset/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Configuration for boxset, which prepares video for the web.",
  "properties": {
    "defaults": {
      "additionalProperties": false,
      "description": "Target settings shared by every target. A target's own value always wins.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "const": false,
              "description": "Switch this off."
            },
            {
              "additionalProperties": false,
              "properties": {
                "bitrate": {
                  "$comment": "a bitrate like 128k",
                  "description": "Audio bitrate, as ffmpeg spells it.",
                  "pattern": "^\\d+k$",
                  "type": "string"
                },
                "normalize": {
                  "description": "Even out loudness across the track.",
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          ],
          "description": "Audio settings, or false to drop the track."
        },
        "av1": {
          "additionalProperties": false,
          "description": "ffmpeg overrides for av1.",
          "properties": {
            "crf": {
              "description": "Constant rate factor. Lower is better quality and a larger file.",
              "maximum": 63,
              "minimum": 0,
              "type": "integer"
            },
            "extra_args": {
              "description": "Extra ffmpeg arguments, passed through untouched.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "preset": {
              "description": "SVT-AV1 preset, 0 slowest.",
              "maximum": 13,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "codecs": {
          "description": "Which formats to encode.",
          "items": {
            "enum": [
              "h264",
              "h265",
              "vp9",
              "av1"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "crop": {
          "anyOf": [
            {
              "pattern": "^\\d+:\\d+$",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "description": "Which edge the crop window keeps.",
                  "enum": [
                    "centre",
                    "top",
                    "bottom",
                    "left",
                    "right"
                  ],
                  "type": "string"
                },
                "ratio": {
                  "$comment": "an aspect ratio like 16:9",
                  "description": "The aspect ratio to crop to.",
                  "pattern": "^\\d+:\\d+$",
                  "type": "string"
                }
              },
              "type": "object"
            }
          ],
          "description": "Crop to an aspect ratio. A bare string is centred."
        },
        "fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\d+\\s*/\\s*\\d+$",
              "type": "string"
            }
          ],
          "description": "Output frame rate, as a number or a num/den ratio."
        },
        "h264": {
          "additionalProperties": false,
          "description": "ffmpeg overrides for h264.",
          "properties": {
            "crf": {
              "description": "Constant rate factor. Lower is better quality and a larger file.",
              "maximum": 51,
              "minimum": 0,
              "type": "integer"
            },
            "extra_args": {
              "description": "Extra ffmpeg arguments, passed through untouched.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "preset": {
              "description": "Encoder effort. Slower settings compress better.",
              "enum": [
                "ultrafast",
                "superfast",
                "veryfast",
                "faster",
                "fast",
                "medium",
                "slow",
                "slower",
                "veryslow"
              ],
              "type": "string"
            },
            "profile": {
              "description": "H.264 profile, for older device support.",
              "enum": [
                "baseline",
                "main",
                "high"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "h265": {
          "additionalProperties": false,
          "description": "ffmpeg overrides for h265.",
          "properties": {
            "crf": {
              "description": "Constant rate factor. Lower is better quality and a larger file.",
              "maximum": 51,
              "minimum": 0,
              "type": "integer"
            },
            "extra_args": {
              "description": "Extra ffmpeg arguments, passed through untouched.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "preset": {
              "description": "Encoder effort. Slower settings compress better.",
              "enum": [
                "ultrafast",
                "superfast",
                "veryfast",
                "faster",
                "fast",
                "medium",
                "slow",
                "slower",
                "veryslow"
              ],
              "type": "string"
            },
            "profile": {
              "description": "H.265 profile.",
              "enum": [
                "main",
                "main10"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "name": {
          "description": "Base name for this target's outputs.",
          "minLength": 1,
          "type": "string"
        },
        "poster": {
          "anyOf": [
            {
              "const": false,
              "description": "Switch this off."
            },
            {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "$comment": "a timestamp like 00:00:04 or 4.5",
                  "description": "Timestamp of the frame to capture.",
                  "pattern": "^(\\d+(\\.\\d+)?|(\\d+:)?\\d{1,2}:\\d{2}(\\.\\d+)?)$",
                  "type": "string"
                }
              },
              "type": "object"
            }
          ],
          "description": "Poster image settings, or false to skip it."
        },
        "quality": {
          "description": "How hard to compress, trading file size against picture quality.",
          "enum": [
            "low",
            "balanced",
            "high",
            "max"
          ],
          "type": "string"
        },
        "src": {
          "description": "The video to prepare, relative to this config.",
          "minLength": 1,
          "type": "string"
        },
        "subtitles": {
          "anyOf": [
            {
              "const": false,
              "description": "Switch this off."
            },
            {
              "additionalProperties": false,
              "properties": {
                "model": {
                  "description": "Which transcription model to run.",
                  "enum": [
                    "whisper-tiny",
                    "whisper-base",
                    "whisper-small",
                    "whisper-medium",
                    "whisper-large",
                    "parakeet-110m",
                    "parakeet-0.6b"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            }
          ],
          "description": "Subtitle settings, or false to skip them."
        },
        "trim": {
          "additionalProperties": false,
          "description": "Cut the output to a time range.",
          "properties": {
            "end": {
              "$comment": "a timestamp like 00:00:04 or 4.5",
              "description": "Where the output ends.",
              "pattern": "^(\\d+(\\.\\d+)?|(\\d+:)?\\d{1,2}:\\d{2}(\\.\\d+)?)$",
              "type": "string"
            },
            "start": {
              "$comment": "a timestamp like 00:00:04 or 4.5",
              "description": "Where the output begins.",
              "pattern": "^(\\d+(\\.\\d+)?|(\\d+:)?\\d{1,2}:\\d{2}(\\.\\d+)?)$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "vp9": {
          "additionalProperties": false,
          "description": "ffmpeg overrides for vp9.",
          "properties": {
            "cpu_used": {
              "description": "Encoder effort, 0 slowest. Above 3 encodes worse at every CRF, not merely faster.",
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            "crf": {
              "description": "Constant rate factor. Lower is better quality and a larger file.",
              "maximum": 63,
              "minimum": 0,
              "type": "integer"
            },
            "extra_args": {
              "description": "Extra ffmpeg arguments, passed through untouched.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "row_mt": {
              "description": "Row-based multithreading.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "widths": {
          "description": "Output widths in pixels.",
          "items": {
            "maximum": 16384,
            "minimum": 16,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "jobs": {
      "description": "How many encodes run at once.",
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "out_dir": {
      "description": "Where outputs are written, relative to this config.",
      "minLength": 1,
      "type": "string"
    },
